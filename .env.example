# Copy to .env.local. Never commit .env.local.
# Jev and LLM calls are server-side only.
# Keys listed here are the process.env names src/ and scripts/ actually read.

# live | cached | offline. Unset parses as offline.
RANGAZA_MODE=offline

# Gateway model picker for Brief and Explainer. anthropic | google | openai
# All three resolve through AI_GATEWAY_API_KEY. Direct Anthropic is the only non-Gateway fallback.
RANGAZA_LLM_PROVIDER=anthropic

# Live credential for Jev (experimental_evaluate, typesafe-ai/jev) and for Brief/Explainer via Gateway.
AI_GATEWAY_API_KEY=

# Direct Anthropic fallback when AI_GATEWAY_API_KEY is unset.
ANTHROPIC_API_KEY=

# Optional direct TypeSafe key for Jev. Not required when the Gateway key is set.
TYPESAFE_API_KEY=

# Override the evaluate model id. Default typesafe-ai/jev.
RANGAZA_JEV_MODEL=

# Jev calls in flight inside one batch. The engine caps this at 2.
JEV_CONCURRENCY=2

# scripts/react-sample.ts only: how many Residents to send to live Jev. Default 3.
# The mock sample stays fixed at 50; this caps only the live Gateway calls.
JEV_SAMPLE_SIZE=3
